# Which LLM backend to use: anthropic | nvidia | ollama
LLM_BACKEND=nvidia

# Retrieval cutoff: answers scoring below this are treated as "not found"
MIN_SCORE=0.30

# --- NVIDIA (build.nvidia.com) ---
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b

# --- Anthropic ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# --- Ollama (local) ---
OLLAMA_MODEL=llama3.1:8b